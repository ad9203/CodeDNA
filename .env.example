# Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./codedna.db
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
API_V1_PREFIX=/api

# Required external services
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GROQ_API_KEY=
HINDSIGHT_API_KEY=

# External service endpoints
GITHUB_API_BASE_URL=https://api.github.com
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Model/configuration
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=6000
HINDSIGHT_BANK_PREFIX=codedna
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_MAX_RECALL_TOKENS=4096

# Optional GitHub App path for enterprise mode
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=

# Worker/retry controls
MAX_EXTERNAL_RETRIES=3
INITIAL_RETRY_DELAY_SECONDS=0.5
MAX_RETRY_DELAY_SECONDS=8

# Security limits
MAX_PR_FILES=100
MAX_DIFF_CHARS=150000
MAX_MEMORY_CHARS=40000
